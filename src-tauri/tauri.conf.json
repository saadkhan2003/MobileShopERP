{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mobile Shop ERP",
  "version": "0.4.4",
  "identifier": "com.mobileshop.erp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Mobile Shop ERP", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 700, "backgroundColor": "#f6f7f4" }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"] }
}
